{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agent-handoff-bridge",
  "version": "0.4.6",
  "identifier": "com.jh3779.agenthandoffbridge",
  "build": {
    "frontendDist": "../webui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/agent-handoff-bridge-server",
      "binaries/agent-handoff-bridge-cli",
      "binaries/agent-handoff-bridge-validate",
      "binaries/agent-handoff-bridge-scan"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBMzg4RDhENjY2N0IzRTQKUldUa3MyZG1qWTA0K3BJNmhwTGJRZFIxekczSDZWQnBrbWE5NUFkVVlBeEIvRHdFM21NOTI2NmQK",
      "endpoints": [
        "https://github.com/jh3779/agent-handoff-bridge/releases/latest/download/latest.json"
      ]
    }
  }
}
